# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Обязательно ---
# Надёжный ключ подписи сессий: openssl rand -hex 32
SECRET_KEY=
# Пароль базы данных (придумайте длинный)
POSTGRES_USER=operdir
POSTGRES_PASSWORD=
POSTGRES_DB=operdir
# Первый владелец создаётся при первом запуске, если в базе нет пользователей
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Порт, на котором будет доступен сайт ---
HTTP_PORT=80

# --- Модель ИИ (без ключа чат отвечает, что ИИ не подключён) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=

# --- Интеграции (необязательно, можно заполнять по мере подключения) ---
BITRIX24_WEBHOOK_URL=
# (ключ сервисного аккаунта Google больше не нужен: таблицы подключаются по ссылкам)
# id или ссылки на таблицы РНП через запятую (доступ по ссылке должен быть открыт)
RNP_SPREADSHEET_IDS=
# Один токен Яндекса: Метрика, Вебмастер, Диск
YANDEX_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=
TELEGRAM_BOT_TOKEN=
# Почта по IMAP
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# FTP-сервер для файлов на анализ (FTP_TLS=true для FTPS)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_TLS=false
FTP_DIR=/
# Пока только фиксируют наличие данных; полноценная проверка появится вместе с интеграцией
DIADOC_CLIENT_ID=
DIADOC_LOGIN=
DIADOC_PASSWORD=
MIRZAP_MCP_URL=
MIRZAP_MCP_TOKEN=
GOOGLE_CALENDAR_IDS=
YANDEX_CALENDAR_LOGIN=
YANDEX_CALENDAR_PASSWORD=

# --- Проверки интеграций ---
INTEGRATION_CHECK_MINUTES=60
ONEC_EXPECTED_INTERVAL_HOURS=24
