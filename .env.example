# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Обязательно ---
# Надёжный ключ подписи сессий: openssl rand -hex 32
SECRET_KEY=
# Пароль базы данных (придумайте длинный)
POSTGRES_USER=operdir
POSTGRES_PASSWORD=
POSTGRES_DB=operdir
# Первый владелец создаётся при первом запуске, если в базе нет пользователей
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Порт, на котором будет доступен сайт ---
HTTP_PORT=80

# --- Модель ИИ (без ключа чат отвечает, что ИИ не подключён) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=

# --- Интеграции (необязательно, можно заполнять по мере подключения) ---
BITRIX24_WEBHOOK_URL=
# Файл ключа сервисного аккаунта Google: положите в папку secrets/ и укажите путь внутри контейнера
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets-app/google-service-account.json
# id таблиц РНП через запятую (часть ссылки между /d/ и /edit)
RNP_SPREADSHEET_IDS=
YANDEX_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# --- Проверки интеграций ---
INTEGRATION_CHECK_MINUTES=60
ONEC_EXPECTED_INTERVAL_HOURS=24
